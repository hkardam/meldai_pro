# ==============================================================================
# Environment Configuration for MeldAI Medical Science Platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Docker Remote Debugging (debugpy)
# When DEBUG_MODE=true, the container starts debugpy on port 5678
DEBUG_MODE=true
DEBUG_PORT=5678
# Set WAIT_FOR_DEBUGGER=true if you want python to pause at startup until VS Code / IDE attaches
WAIT_FOR_DEBUGGER=false

# ------------------------------------------------------------------------------
# PostgreSQL (External Source for Training Data & Clinical Records)
# ------------------------------------------------------------------------------
# Use host.docker.internal if PostgreSQL runs on the host machine, or specify external IP/hostname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medical_db
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# MongoDB (Internal Docker Sink & Clinical Knowledge Base)
# ------------------------------------------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_secure_pass
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=meldai_knowledge_base
MONGO_URI=mongodb://admin:admin_secure_pass@mongodb:27017/meldai_knowledge_base?authSource=admin

# ------------------------------------------------------------------------------
# Clinical NLP: SapBERT Clinical Embeddings
# ------------------------------------------------------------------------------
# Hugging Face model for self-alignment pretraining on biomedical entities
SAPBERT_MODEL_NAME=cambridgeltl/SapBERT-from-PubMedBERT-fulltext
DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# ------------------------------------------------------------------------------
# Clinical NLP: BioLORD Clinical Concept Embeddings
# ------------------------------------------------------------------------------
BIOLORD_MODEL_NAME=FremyCompany/BioLORD-2023
BIOLORD_BATCH_SIZE=32
BIOLORD_MAX_LENGTH=128
MEDICINE_MASTER_JSON_PATH=data/medication/local_medicine_master.json

# ------------------------------------------------------------------------------
# LLM Service: Google Gemini for Prescription Recommendation
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
