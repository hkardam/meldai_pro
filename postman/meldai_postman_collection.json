                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": [\n    \"severe headache\",\n    \"denies fever\",\n    \"chronic insomnia\"\n  ],\n  \"top_k\": 3\n}",
              "options": {
